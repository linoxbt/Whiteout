import { createRequire } from 'node:module';
import { readFileSync } from 'node:fs';
import { Ed25519Keypair } from '@mysten/sui/keypairs/ed25519';
import { loadConfig, makeClient } from '@whiteout/core';
import deploy from '../../deploy/testnet.json' with { type: 'json' };
import { connect, installWallet } from './wallet.js';
const { chromium } = createRequire(import.meta.url)('playwright') as typeof import('playwright');
const s = JSON.parse(readFileSync(process.env.LIVE_STATE!, 'utf8'));
const client = makeClient(loadConfig('testnet', deploy as never));
const kp = Ed25519Keypair.fromSecretKey(s.keys[process.argv[2] ?? 'p1']);
const b = await chromium.launch();
const page = await (await b.newContext({ viewport: { width: 1360, height: 900 } })).newPage();
page.on('console', (m) => console.log(`[${m.type()}]`, m.text().slice(0, 600)));
page.on('pageerror', (e) => console.log('[pageerror]', e.message));
page.on('requestfailed', (r) => console.log('[reqfail]', r.url().slice(0, 120), r.failure()?.errorText));
page.on('response', (r) => { if (r.status() >= 400) console.log('[http]', r.status(), r.url().slice(0, 140)); });
const log = await installWallet(page, 'Dbg', kp, client);
await page.goto((process.env.SITE ?? 'https://whiteout-hunt.netlify.app/') + '#/hunt/' + s.huntK.gameId, { waitUntil: 'load' });
await connect(page, 'Dbg');
await page.waitForTimeout(4000);
const allow = page.getByRole('button', { name: 'Allow' });
console.log('session prompt visible:', await allow.isVisible());
if (await allow.isVisible()) await allow.click();
const claim = page.getByRole('button', { name: /Claim the relic/ });
await claim.waitFor({ timeout: 60000 });
await claim.click();
await page.waitForTimeout(15000);
console.log('notice:', await page.locator('.notice').allInnerTexts());
console.log('wallet', JSON.stringify(log));
console.log(await page.innerText('.here').catch(() => 'no .here'));
await b.close();
